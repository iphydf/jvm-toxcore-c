#!/usr/bin/env python3
"""Writes Nodes.kt from nodes.tox.chat's list, for a release to start from.
The client never fetches the list itself."""

import ipaddress
import json
import pathlib
import sys
import urllib.request

URL = "https://nodes.tox.chat/json"
OUT = (pathlib.Path(__file__).parent.parent / "shared/src/commonMain/kotlin/chat/tox/ktox/Nodes.kt")


def is_ip(host: str) -> bool:
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        return False


def main() -> None:
    with urllib.request.urlopen(URL, timeout=60) as response:
        # Only nodes with an IP address: bootstrapping from a host name looks
        # it up on the Tox thread.
        nodes = [node for node in json.load(response)["nodes"] if is_ip(node["ipv4"])]
    # The list has no nodes when its scan finds none, and that mustn't
    # replace the last one.
    if not any(node["status_udp"] for node in nodes) or not any(node["status_tcp"] for node in nodes):
        sys.exit(f"{URL} has no working nodes now: try again later")
    entries = "".join(
        f"        Node({json.dumps(node['ipv4'])}, {node['port']}, "
        f"listOf({', '.join(str(p) for p in node['tcp_ports'])}), "
        f"{json.dumps(node['public_key'])}),\n"
        for node in nodes if node["status_udp"] or node["status_tcp"])
    OUT.write_text(f"""\
// Code generated by tools/update-nodes from {URL}. DO NOT EDIT.
// Run it again before each release.

package chat.tox.ktox

/** The nodes the last check of the list reached. */
internal val builtInNodes =
    listOf(
{entries}    )
""")


if __name__ == "__main__":
    main()
