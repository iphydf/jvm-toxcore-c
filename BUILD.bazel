tox4j_test(
    name = "Tox4jIntegrationTest",
    # `manual` keeps the integration suite out of `bazel test //...`
    # wildcard expansion — bare `bazel test //jvm-toxcore-c/...`
    # skips it. Run explicitly with
    # `bazel test //jvm-toxcore-c:Tox4jIntegrationTest`
    # when needed (the suite drives a 30s-bootstrap-convergence loop
    # per scenario, so it doesn't belong in the fast tier).
    size = "medium",
    srcs = [
        "lib/src/test/java/im/tox/tox4j/e2e/SubtestConference.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/SubtestCustomPacket.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/SubtestFile.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/SubtestFileCancel.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/SubtestFriendInfo.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/SubtestGroup.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/SubtestMessage.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/SubtestPersistence.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/SubtestToxav.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/Tox4jHarness.kt",
        "lib/src/test/java/im/tox/tox4j/e2e/Tox4jIntegrationTest.kt",
    ],
    package = "im.tox.tox4j.e2e",
    tags = [
        "e2e",
        "manual",
    ],
)

ktlint_fix(
